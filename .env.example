# Moyasar Payment Gateway Configuration
# Get these from https://moyasar.com/dashboard

# Publishable Key (can be exposed to frontend)
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=pk_live_...

# Secret Keys (server-side only)
MOYASAR_SECRET_KEY=sk_live_...          # Production
MOYASAR_SECRET_KEY_Test=sk_test_...     # Development/Testing

# Site URL for callbacks
NEXT_PUBLIC_SITE_URL=https://nukhba.media

# ─── Tamara Payment Gateway ─────────────────────────────────────────────────
# Get tokens from: partners.tamara.co → Settings → API Tokens
# (Admin role required to generate tokens)

TAMARA_API_TOKEN=your_live_api_token           # Production API token (server-only)
TAMARA_API_TOKEN_SANDBOX=your_sandbox_token    # Sandbox token for testing (server-only)
TAMARA_NOTIFICATION_TOKEN=your_notification_token  # For verifying webhooks (server-only)

# Register webhook URL once in: Partners Portal → Settings → Webhooks
# URL: https://nukhba.media/api/webhooks/tamara  |  Event: Approved (mandatory)

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=...
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# X OAuth (server-side only)
# Keep one stable 64-character hexadecimal encryption key across every runtime.
# Changing it makes already-stored X OAuth tokens unreadable and requires reconnecting X.
X_CLIENT_ID=...
X_CLIENT_SECRET=...
X_REDIRECT_URI=https://nukhba.media/api/integrations/x/callback
X_TOKEN_ENCRYPTION_KEY=64_hex_characters

# Protects scheduled server-to-server jobs such as /api/cron/x-growth.
CRON_API_KEY=replace_with_a_long_random_value
